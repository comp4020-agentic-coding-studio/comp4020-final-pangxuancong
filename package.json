{
  "name": "comp4020-final",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/main.ts",
    "start": "NODE_ENV=production node src/server/main.ts",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "check:evidence": "node scripts/check-evidence.ts",
    "test": "vitest run",
    "build": "vite build"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.0",
    "phaser": "3.90.0",
    "socket.io-client": "4.8.4",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "pnpm": ">=11"
  },
  "dependencies": {
    "express": "^5.2.1",
    "marked": "^18.0.14",
    "socket.io": "4.8.4"
  }
}
